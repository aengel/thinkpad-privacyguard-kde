#!/usr/bin/env python3
"""
ThinkPad PrivacyGuard KDE OSD & Brightness Daemon

Monitors DRM uevents triggered by Fn+D (thinkpad_acpi lcdshadow), displays
a native KDE Plasma OSD notification, and automatically adjusts screen
brightness so the ePrivacy filter works effectively (matching Lenovo Vantage
behavior on Windows).
"""
import os
import re
import subprocess

PRIVACY_BRIGHTNESS = int(os.environ.get("PRIVACY_BRIGHTNESS", "2500"))  # 25% of 10000 max
DEFAULT_RESTORE_BRIGHTNESS = int(os.environ.get("DEFAULT_RESTORE_BRIGHTNESS", "7500"))  # 75% fallback
LCDSHADOW_PATH = "/proc/acpi/ibm/lcdshadow"


def get_status():
    try:
        with open(LCDSHADOW_PATH, "r") as f:
            for line in f:
                if line.startswith("status:"):
                    return int(line.split(":")[1].strip())
    except Exception:
        pass
    return None


def get_brightness():
    try:
        res = subprocess.run(
            [
                "gdbus", "call", "--session",
                "--dest", "org.kde.Solid.PowerManagement",
                "--object-path", "/org/kde/Solid/PowerManagement/Actions/BrightnessControl",
                "--method", "org.kde.Solid.PowerManagement.Actions.BrightnessControl.brightness",
            ],
            capture_output=True,
            text=True,
        )
        m = re.search(r"\((\d+),?\)", res.stdout)
        if m:
            return int(m.group(1))
    except Exception:
        pass
    return None


def set_brightness_silent(val):
    subprocess.run(
        [
            "gdbus", "call", "--session",
            "--dest", "org.kde.Solid.PowerManagement",
            "--object-path", "/org/kde/Solid/PowerManagement/Actions/BrightnessControl",
            "--method", "org.kde.Solid.PowerManagement.Actions.BrightnessControl.setBrightnessSilent",
            str(int(val)),
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def show_osd(status):
    if status == 1:
        icon = "view-private"
        text = "PrivacyGuard: Eingeschaltet"
    else:
        icon = "view-visible"
        text = "PrivacyGuard: Ausgeschaltet"
    subprocess.run(
        [
            "gdbus", "call", "--session",
            "--dest", "org.kde.plasmashell",
            "--object-path", "/org/kde/osdService",
            "--method", "org.kde.osdService.showText",
            icon, text,
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def main():
    last_status = get_status()
    saved_brightness = get_brightness() or DEFAULT_RESTORE_BRIGHTNESS

    proc = subprocess.Popen(
        ["udevadm", "monitor", "--udev", "--subsystem-match=drm"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        bufsize=1,
    )
    for line in proc.stdout:
        if "change" in line and "card" in line:
            current = get_status()
            if current is not None and current != last_status:
                last_status = current
                if current == 1:
                    cur_b = get_brightness()
                    if cur_b is not None and cur_b > PRIVACY_BRIGHTNESS:
                        saved_brightness = cur_b
                        set_brightness_silent(PRIVACY_BRIGHTNESS)
                else:
                    cur_b = get_brightness()
                    target_b = saved_brightness if saved_brightness > PRIVACY_BRIGHTNESS else DEFAULT_RESTORE_BRIGHTNESS
                    if cur_b is not None and cur_b <= PRIVACY_BRIGHTNESS + 500:
                        set_brightness_silent(target_b)
                show_osd(current)


if __name__ == "__main__":
    main()
